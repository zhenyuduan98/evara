}

// === Tax Rates ===

model TaxRate {
  id       String  @id @default(cuid())
  country  String  @default("US")
  state    String
  rate     Float
  category String  @default("general")

  @@unique([country, state, category])
  @@index([country, state])
}

// === Payout Batches ===

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PayoutBatch {
  id             String       @id @default(cuid())
  sellerId       String
  seller         Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(10, 2)
  status         PayoutStatus @default(PENDING)
  stripePayoutId String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([sellerId])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UploadedFile {
  id        String   @id @default(cuid())
  filename  String
  path      String
  mimeType  String
  size      Int
  userId    String?
  createdAt DateTime @default(now())
}

// === Live Chat ===

enum ChatSessionStatus {
  ACTIVE
  CLOSED
}

enum ChatSenderType {
  USER
  AGENT
  BOT
}

model ChatSession {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation("UserChatSessions", fields: [userId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     User?             @relation("AgentChatSessions", fields: [agentId], references: [id], onDelete: SetNull)
  status    ChatSessionStatus @default(ACTIVE)
  messages  ChatMessage[]
  createdAt DateTime          @default(now())
  closedAt  DateTime?

  @@index([userId])
}

model ChatMessage {
  id         String         @id @default(cuid())
  sessionId  String
  session    ChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderType ChatSenderType
  content    String         @db.Text
  createdAt  DateTime       @default(now())

  @@index([sessionId, createdAt])
}

model TicketFeedback {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// === Seller Messaging ===

model SellerMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  sellerId   String
  orderId    String?
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([sellerId])
  @@index([senderId])
  @@index([receiverId])
}

// === Seller Performance ===

model SellerPerformance {
  id               String   @id @default(cuid())
  sellerId         String
  period           String
  orderDefectRate  Float    @default(0)
  lateShipRate     Float    @default(0)
  cancellationRate Float    @default(0)
  responseTime     Float    @default(0)
  score            Float    @default(100)
  createdAt        DateTime @default(now())

  @@unique([sellerId, period])
  @@index([sellerId])
}

// === Seller Appeal ===

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

model SellerAppeal {
  id        String       @id @default(cuid())
  sellerId  String
  reason    String       @db.Text
  status    AppealStatus @default(PENDING)
  response  String?      @db.Text
  createdAt DateTime     @default(now())

  @@index([sellerId])
}

// === WMS Pick Lists ===

enum PickListStatus {
  PENDING
  PICKING
  PICKED
  PACKED
  SHIPPED
}

model PickList {
  id          String         @id @default(cuid())
  warehouseId String
  orderId     String
  status      PickListStatus @default(PENDING)
  items       Json
  assignedTo  String?
  createdAt   DateTime       @default(now())

  @@index([warehouseId])
  @@index([orderId])
  @@index([status])
}

model WarehouseBin {
  id          String @id @default(cuid())
  warehouseId String
  productId   String
  binLocation String
  quantity    Int    @default(0)

  @@unique([warehouseId, productId])
  @@index([warehouseId])
}

// === Review Flags ===

enum FlagStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReviewFlag {
  id        String     @id @default(cuid())
  reviewId  String
  review    Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  reason    String
  status    FlagStatus @default(PENDING)
  createdAt DateTime   @default(now())

  @@index([reviewId])
  @@index([status])
}

// === Brand ===

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
