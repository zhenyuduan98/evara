  updatedAt         DateTime @updatedAt
}

model LoyaltyTierConfig {
  id              String     @id @default(cuid())
  tier            LoyaltyTier @unique
  minPoints       Int
  pointMultiplier Decimal    @db.Decimal(10, 2)
  benefits        Json
