generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SELLER
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  phone             String?
  password          String?
  role              Role               @default(USER)
  createdAt         DateTime           @default(now())
  deactivatedAt     DateTime?
  updatedAt         DateTime           @updatedAt
  accounts          Account[]
  sessions          Session[]
  products          Product[]
  cart              Cart?
  addresses         Address[]
  reviews           Review[]
  reviewVotes       ReviewVote[]
  orders            Order[]
  seller            Seller?
  membership        Membership?
  viewHistory       ViewHistory[]
  questions         Question[]
  answers           Answer[]
  answerVotes       AnswerVote[]
  refunds           Refund[]
  tickets           Ticket[]
  affiliateLinks    AffiliateLink[]
  sponsoredProducts SponsoredProduct[] @relation("SponsoredProducts")
  notifications     Notification[]
  adminAuditLogs    AdminAuditLog[]   @relation("AdminAuditLogs")
  pushSubscriptions     PushSubscription[]
  notificationPreferences NotificationPreference[]
  wishlists             Wishlist[]
  buyerShowcases        BuyerShowcase[]
  passwordResetTokens   PasswordResetToken[]
  chatSessions          ChatSession[]        @relation("UserChatSessions")
  agentChatSessions     ChatSession[]        @relation("AgentChatSessions")
  chatMessages          ChatMessage[]
  ticketFeedbacks       TicketFeedback[]
  emailVerifyTokens     EmailVerificationToken[]
  passwordStrength      String?
  twoFactorSecret       TwoFactorSecret?
  loginActivities       LoginActivity[]
  recoveryCodes         RecoveryCode[]
  giftCards             GiftCard[]
  wallet                Wallet?
  paymentMethods        PaymentMethod[]
  loyaltyTier           LoyaltyTier        @default(BRONZE)
  subscriptions         Subscription[]
  userBehaviors         UserBehavior[]
  sellerAuctions        Auction[]        @relation("SellerAuctions")
  bidderAuctions        Auction[]        @relation("BidderAuctions")
  auctionBids           AuctionBid[]
  giftRegistries        GiftRegistry[]
  businessAccount       BusinessAccount?
  vineReviewer          VineReviewer?
  liveStreams           LiveStream[]     @relation("SellerLiveStreams")
  liveComments          LiveComment[]    @relation("UserLiveComments")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]  @relation("ProductCategories")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id              String             @id @default(cuid())
  title           String
  slug            String             @unique
  description     String?            @db.Text
  bulletPoints    String[]
  brand           String
  price           Decimal            @db.Decimal(10, 2)
  compareAtPrice  Decimal?           @db.Decimal(10, 2)
  sku             String             @unique
  status          ProductStatus      @default(DRAFT)
  averageRating   Float              @default(0)
  reviewCount     Int                @default(0)
  sellerId        String
  seller          User               @relation(fields: [sellerId], references: [id])
  categories      Category[]         @relation("ProductCategories")
  variants        ProductVariant[]
  images          ProductImage[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  deals           Deal[]
  attributes      ProductAttribute[]
  priceHistory    PriceHistory[]
  viewHistory     ViewHistory[]
  questions       Question[]
  affiliateLinks  AffiliateLink[]
  sponsoredAds    SponsoredProduct[]
  sellerProfileId String?
  sellerProfile   Seller?            @relation(fields: [sellerProfileId], references: [id])
  brandId         String?
  brandRef        Brand?             @relation("ProductBrand", fields: [brandId], references: [id])
  videoUrl        String?
  isDigital       Boolean            @default(false)
  digitalFileUrl  String?
  wishlists       Wishlist[]
  buyerShowcases  BuyerShowcase[]
  digitalDeliveries DigitalDelivery[]
  subscriptions     Subscription[]
  userBehaviors     UserBehavior[]
  auctions          Auction[]
  giftRegistryItems GiftRegistryItem[]
  bulkDiscounts     BulkDiscount[]
  vineProducts      VineProduct[]
  liveProducts      LiveProduct[]
  barcodes          Barcode[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model ProductVariant {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String         @unique
  price      Decimal?       @db.Decimal(10, 2)
  stock      Int            @default(0)
  options    Json
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  createdAt  DateTime       @default(now())
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url       String
  alt       String?
  position  Int             @default(0)
  createdAt DateTime        @default(now())
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id            String          @id @default(cuid())
  cartId        String
  cart          Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity      Int             @default(1)
  savedForLater Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@unique([cartId, productId, variantId])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zipCode      String
  country      String   @default("US")
  phone        String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]  @relation("ShippingAddress")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  shippingCost      Decimal     @db.Decimal(10, 2)
  tax               Decimal     @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  shippingAddressId String
  shippingAddress   Address     @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  shippingMethod    String
  paymentIntentId   String?
  paidAt            DateTime?
  couponId          String?
  coupon            Coupon?     @relation(fields: [couponId], references: [id])
  items             OrderItem[]
  refunds           Refund[]
  disputes          Dispute[]
  invoice           Invoice?
  digitalDeliveries DigitalDelivery[]
  installmentPlan   InstallmentPlan?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title     String
  price     Decimal         @db.Decimal(10, 2)
  quantity  Int
  taxAmount Decimal?        @db.Decimal(10, 2)
  imageUrl  String?
  digitalDelivery DigitalDelivery?
}

model Review {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating           Int
  title            String
  body             String       @db.Text
  images           String[]
  verifiedPurchase Boolean      @default(false)
  helpfulCount     Int          @default(0)
  votes            ReviewVote[]
  flags            ReviewFlag[]
  hidden           Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([userId, productId])
}

model ReviewVote {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId String
  review   Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  helpful  Boolean

  @@unique([userId, reviewId])
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  type           CouponType
  value          Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  maxUses        Int?
  currentUses    Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  categoryId     String?
  orders         Order[]
  userCoupons    UserCoupon[]
  createdAt      DateTime     @default(now())
}

model Deal {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPercent Int
  startDate       DateTime
  endDate         DateTime
  featured        Boolean  @default(false)
  maxQuantity     Int      @default(100)
  claimedQuantity Int      @default(0)
  createdAt       DateTime @default(now())
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model Seller {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String
  description  String?             @db.Text
  logo         String?
  rating       Float               @default(0)
  status       SellerStatus        @default(PENDING)
  kycVerified  Boolean             @default(false)
  products     Product[]
  transactions SellerTransaction[]
  payoutBatches PayoutBatch[]
  kycDocuments  SellerKYC[]
  teamMembers   SellerTeamMember[]
  apiKeys       SellerAPIKey[]
  commissionRates CommissionRate[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ProductAttribute {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key        String
  value      String
  filterable Boolean @default(false)

  @@index([productId])
  @@index([key, value])
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(10, 2)
  changedAt DateTime @default(now())

  @@index([productId, changedAt])
}

model ViewHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@index([userId, viewedAt])
  @@index([productId])
}

model Question {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  answers   Answer[]
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model Answer {
  id           String       @id @default(cuid())
  questionId   String
  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  body         String       @db.Text
  isSeller     Boolean      @default(false)
  helpfulCount Int          @default(0)
  votes        AnswerVote[]
  createdAt    DateTime     @default(now())

  @@index([questionId, createdAt])
}

model AnswerVote {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerId String
  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, answerId])
}

enum MembershipTier {
  FREE
  PRIME
  PRIME_PLUS
}

model Membership {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      MembershipTier @default(FREE)
  expiresAt DateTime?
  benefits  Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

enum InventoryLogType {
  RESTOCK
  SALE
  ADJUSTMENT
  RESERVE
  RELEASE
}

model InventoryLog {
  id        String           @id @default(cuid())
  productId String
  variantId String?
  type      InventoryLogType
  quantity  Int
  note      String?
  createdAt DateTime         @default(now())

  @@index([productId])
  @@index([variantId])
}

enum PromotionType {
  FLASH_SALE
  LIGHTNING_DEAL
  BUY_X_GET_Y
  PERCENTAGE
  FIXED
}

model Promotion {
  id            String        @id @default(cuid())
  title         String
  description   String?       @db.Text
  type          PromotionType
  value         Decimal       @db.Decimal(10, 2)
  minQuantity   Int?
  productIds    String[]
  categoryIds   String[]
  startDate     DateTime
  endDate       DateTime
  maxClaims     Int?
  currentClaims Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
}

model UserCoupon {
  id        String    @id @default(cuid())
  userId    String
  couponId  String
  coupon    Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  claimedAt DateTime  @default(now())
  usedAt    DateTime?

  @@unique([userId, couponId])
}

// === Seller Settlement ===

enum SellerTransactionStatus {
  PENDING
  AVAILABLE
  PAID
}

model SellerTransaction {
  id             String                  @id @default(cuid())
  sellerId       String
  seller         Seller                  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderId        String
  orderItemId    String
  amount         Decimal                 @db.Decimal(10, 2)
  commission     Decimal                 @db.Decimal(10, 2)
  commissionRate Float                   @default(0.15)
  net            Decimal                 @db.Decimal(10, 2)
  status         SellerTransactionStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime                @default(now())

  @@index([sellerId])
  @@index([orderId])
}

// === Warehouse & Shipping ===

model Warehouse {
  id        String     @id @default(cuid())
  name      String
  address   String
  city      String
  state     String
  zipCode   String
  isActive  Boolean    @default(true)
  shipments Shipment[]
  createdAt DateTime   @default(now())
}

model ShippingZone {
  id     String         @id @default(cuid())
  name   String
  states String[]
  rates  ShippingRate[]
}

model ShippingRate {
  id        String       @id @default(cuid())
  zoneId    String
  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  method    String
  minWeight Decimal      @db.Decimal(10, 2)
  maxWeight Decimal      @db.Decimal(10, 2)
  cost      Decimal      @db.Decimal(10, 2)
}

enum ShipmentStatus {
  PENDING
  PICKED
  PACKED
  SHIPPED
  IN_TRANSIT
  DELIVERED
}

model Shipment {
  id                String          @id @default(cuid())
  orderId           String
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id])
  trackingNumber    String?
  carrier           String?
  status            ShipmentStatus  @default(PENDING)
  estimatedDelivery DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  trackingEvents    TrackingEvent[]
  createdAt         DateTime        @default(now())

  @@index([orderId])
}

model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  location    String
  description String
  timestamp   DateTime @default(now())

  @@index([shipmentId])
}

// === Returns ===

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  CHANGED_MIND
  NOT_AS_DESCRIBED
  OTHER
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
  RECEIVED
  PROCESSED
  REFUNDED
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  userId      String
  items       Json
  reason      ReturnReason
  status      ReturnStatus @default(PENDING)
  returnLabel String?
  adminNote   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orderId])
  @@index([userId])
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RefundType {
  FULL
  PARTIAL
}

model Refund {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  status    RefundStatus @default(PENDING)
  amount    Decimal      @db.Decimal(10, 2)
  type      RefundType
  adminNote String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model SellerReview {
  id        String   @id @default(cuid())
  buyerId   String
  sellerId  String
  orderId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([buyerId, sellerId, orderId])
  @@index([sellerId])
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber String   @unique
  items         Json
  subtotal      Decimal  @db.Decimal(10, 2)
  tax           Decimal  @db.Decimal(10, 2)
  shipping      Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
}

// === Support Tickets ===

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String
  status    TicketStatus    @default(OPEN)
  priority  TicketPriority  @default(MEDIUM)
  messages    TicketMessage[]
  assignedTo  String?
  slaDeadline DateTime?
  csatScore   Int?
  feedbacks   TicketFeedback[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  body      String   @db.Text
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// === Help Center ===

model HelpArticle {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  body        String    @db.Text
  category    String
  categoryId  String?
  tags        String[]
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Campaign {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  description        String
  bannerImage        String?
  featuredProductIds String[]
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model AffiliateLink {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  code        String   @unique
  clicks      Int      @default(0)
  conversions Int      @default(0)
  earnings    Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  affiliateClicks AffiliateClick[]
}

model SponsoredProduct {
  id          String   @id @default(cuid())
  productId   String
  sellerId    String
  bid         Decimal  @db.Decimal(10, 2)
  dailyBudget Decimal  @db.Decimal(10, 2)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller      User     @relation("SponsoredProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  adBids      AdBid[]
  adImpressions AdImpression[]
  adClicks    AdClick[]
}

model ContentBlock {
  id        String   @id @default(cuid())
  type      String
  title     String?
  config    Json
  position  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  category  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
}

// === User Auth Enhancement ===

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model TwoFactorSecret {
