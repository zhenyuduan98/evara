  admin     User     @relation("AdminAuditLogs", fields: [adminId], references: [id])
  action    String
  target    String
  targetId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([target])
}

model PlatformAnnouncement {
  id        String           @id @default(cuid())
