// Subscribe & Save
enum SubscriptionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
}

model Subscription {
  id              String                @id @default(cuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  frequency       SubscriptionFrequency
  quantity        Int                   @default(1)
  discountPercent Decimal               @db.Decimal(5, 2)
  nextDelivery    DateTime
  status          String                @default("ACTIVE")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  orders          SubscriptionOrder[]

  @@index([userId, status])
  @@index([nextDelivery, status])
}

model SubscriptionOrder {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  orderId        String?
  scheduledDate  DateTime
  processedAt    DateTime?
  status         String        @default("PENDING")
  createdAt      DateTime      @default(now())

  @@index([subscriptionId])
  @@index([status, scheduledDate])
}

model Auction {
  id              String       @id @default(cuid())
  productId       String?
  product         Product?     @relation(fields: [productId], references: [id])
  sellerId        String
  seller          User         @relation("SellerAuctions", fields: [sellerId], references: [id])
  title           String
  description     String?      @db.Text
  startPrice      Decimal      @db.Decimal(10, 2)
  currentBid      Decimal?     @db.Decimal(10, 2)
  currentBidderId String?
  currentBidder   User?        @relation("BidderAuctions", fields: [currentBidderId], references: [id])
  startAt         DateTime
  endsAt          DateTime
  status          String       @default("SCHEDULED")
  bidCount        Int          @default(0)
  bids            AuctionBid[]
  createdAt       DateTime     @default(now())

  @@index([status, endsAt])
  @@index([sellerId])
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt])
  @@index([userId])
}

enum GiftRegistryEvent {
  WEDDING
  BIRTHDAY
  BABY_SHOWER
  HOLIDAY
  HOUSEWARMING
  OTHER
}

model GiftRegistry {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  eventType   GiftRegistryEvent
  eventDate   DateTime?
  description String?
  isPublic    Boolean           @default(true)
  shareCode   String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       GiftRegistryItem[]

  @@index([userId])
  @@index([shareCode])
}

model GiftRegistryItem {
  id                String       @id @default(cuid())
  registryId        String
  registry          GiftRegistry @relation(fields: [registryId], references: [id], onDelete: Cascade)
  productId         String
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity          Int          @default(1)
  purchasedQuantity Int          @default(0)
  priority          String       @default("MEDIUM")
  note              String?
  createdAt         DateTime     @default(now())

  @@index([registryId])
}

// === Amazon Vine + Advanced Review System ===

enum VineTier {
  STANDARD
  VINE_VOICE
}

model VineReviewer {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier           VineTier    @default(STANDARD)
  invitedAt      DateTime    @default(now())
  totalReviews   Int         @default(0)
  helpfulPercent Decimal     @default(0) @db.Decimal(5, 2)
  claims         VineClaim[]
}

model VineProduct {
  id               String      @id @default(cuid())
  productId        String
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId         String
  samplesAvailable Int
  samplesClaimed   Int         @default(0)
  createdAt        DateTime    @default(now())
  claims           VineClaim[]

  @@index([productId])
}

model VineClaim {
  id            String       @id @default(cuid())
  vineProductId String
  vineProduct   VineProduct  @relation(fields: [vineProductId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      VineReviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  claimedAt     DateTime     @default(now())
  reviewId      String?

  @@unique([vineProductId, reviewerId])
}

// G8: Amazon Business B2B
model BusinessAccount {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  taxId          String?
  industry       String?
  isVerified     Boolean         @default(false)
  creditLimit    Decimal?        @db.Decimal(10, 2)
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  COMPLETED
}

model PurchaseOrder {
  id                String              @id @default(cuid())
  businessAccountId String
  businessAccount   BusinessAccount     @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  requestedBy       String
  items             Json
  status            PurchaseOrderStatus @default(PENDING_APPROVAL)
  approvedBy        String?
  totalAmount       Decimal             @db.Decimal(10, 2)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model BulkDiscount {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity     Int
  discountPercent Decimal @db.Decimal(5, 2)

  @@index([productId])
}

// === G7: Live Shopping ===

enum LiveStreamStatus {
  SCHEDULED
  LIVE
  ENDED
}

model LiveStream {
  id          String           @id @default(cuid())
  sellerId    String
  seller      User             @relation("SellerLiveStreams", fields: [sellerId], references: [id])
  title       String
  description String?
  status      LiveStreamStatus @default(SCHEDULED)
  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?
  viewerCount Int              @default(0)
  thumbnailUrl String?
  createdAt   DateTime         @default(now())
  products    LiveProduct[]
  comments    LiveComment[]

  @@index([sellerId])
  @@index([status])
}

model LiveProduct {
  id           String     @id @default(cuid())
  streamId     String
  stream       LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayOrder Int        @default(0)
  specialPrice Decimal?   @db.Decimal(10, 2)
  isActive     Boolean    @default(false)

  @@index([streamId])
}

model Barcode {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String   // UPC, EAN, ISBN
  code      String   @unique
  createdAt DateTime @default(now())

  @@index([productId])
}

model LiveComment {
  id        String     @id @default(cuid())
  streamId  String
  stream    LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("UserLiveComments", fields: [userId], references: [id])
  content   String
  createdAt DateTime   @default(now())

  @@index([streamId])
}
