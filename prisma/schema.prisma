  spent              Decimal          @default(0) @db.Decimal(10, 2)
  createdAt          DateTime         @default(now())
  sponsoredProduct   SponsoredProduct @relation(fields: [sponsoredProductId], references: [id], onDelete: Cascade)

  @@index([sponsoredProductId])
}

model AdImpression {
  id                 String           @id @default(cuid())
  sponsoredProductId String
  userId             String?
  page               String
  createdAt          DateTime         @default(now())
  sponsoredProduct   SponsoredProduct @relation(fields: [sponsoredProductId], references: [id], onDelete: Cascade)

  @@index([sponsoredProductId])
  @@index([createdAt])
}

model AdClick {
  id                 String           @id @default(cuid())
  sponsoredProductId String
  userId             String?
  createdAt          DateTime         @default(now())
  sponsoredProduct   SponsoredProduct @relation(fields: [sponsoredProductId], references: [id], onDelete: Cascade)

  @@index([sponsoredProductId])
  @@index([createdAt])
}

model ReferralCode {
  id        String   @id @default(cuid())
  userId    String
  code      String   @unique
  reward    Decimal  @db.Decimal(10, 2)
  usedCount Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoyaltyPoints {
  id             String               @id @default(cuid())
  userId         String               @unique
  points         Int                  @default(0)
  lifetimePoints Int                  @default(0)
  transactions   LoyaltyTransaction[]

  @@index([userId])
}

model LoyaltyTransaction {
  id              String                 @id @default(cuid())
  loyaltyPointsId String
  points          Int
  type            LoyaltyTransactionType
  description     String
  orderId         String?
  createdAt       DateTime               @default(now())
  loyaltyPoints   LoyaltyPoints          @relation(fields: [loyaltyPointsId], references: [id], onDelete: Cascade)

