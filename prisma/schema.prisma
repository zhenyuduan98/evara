// === Seller KYC & Team & API Keys & Commissions ===

enum KYCDocumentType {
  ID
  BUSINESS_LICENSE
  TAX_CERT
}

enum KYCStatus {
  PENDING
  VERIFIED
  REJECTED
}

model SellerKYC {
  id           String          @id @default(cuid())
  sellerId     String
  seller       Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  documentType KYCDocumentType
  documentUrl  String
  status       KYCStatus       @default(PENDING)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime        @default(now())

  @@index([sellerId])
}

enum TeamMemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model SellerTeamMember {
  id         String          @id @default(cuid())
  sellerId   String
  seller     Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userId     String
  role       TeamMemberRole  @default(VIEWER)
  invitedAt  DateTime        @default(now())
  acceptedAt DateTime?

  @@unique([sellerId, userId])
}

model SellerAPIKey {
  id         String   @id @default(cuid())
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  key        String   @unique
  name       String
  permissions Json
  lastUsedAt DateTime?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([sellerId])
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model CommissionRate {
  id         String         @id @default(cuid())
  categoryId String?
  sellerId   String?
  seller     Seller?        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  rate       Decimal        @db.Decimal(10, 2)
  type       CommissionType @default(PERCENTAGE)
  createdAt  DateTime       @default(now())

  @@index([categoryId])
  @@index([sellerId])
}

enum DisputeStatus {
  OPEN
  WON
  LOST
}

model Dispute {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stripeDisputeId  String        @unique
  amount           Decimal       @db.Decimal(10, 2)
  reason           String
  status           DisputeStatus @default(OPEN)
  evidence         String?
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  @@index([orderId])
  @@index([status])
}

// === Inventory Hold (G8) ===

model InventoryHold {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  userId    String
  quantity  Int
  expiresAt DateTime
  orderId   String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@index([expiresAt])
}

// === G9: Finance - Ledger, Tax, Store Credit ===

enum LedgerType {
  DEBIT
  CREDIT
}

model LedgerEntry {
  id          String     @id @default(cuid())
  orderId     String?
  sellerId    String?
  type        LedgerType
  account     String
  amount      Decimal    @db.Decimal(10, 2)
  description String
  reference   String?
  createdAt   DateTime   @default(now())

  @@index([orderId])
  @@index([sellerId])
  @@index([account])
  @@index([createdAt])
}

model StoreCredit {
  id        String    @id @default(cuid())
  userId    String
  amount    Decimal   @db.Decimal(10, 2)
  reason    String
  issuedBy  String?
  orderId   String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([userId])
}

// === G10: Fulfillment Enhancement ===

enum DeliveryWindowType {
  STANDARD
  EXPRESS
  SAME_DAY
}

model DeliveryWindow {
  id            String             @id @default(cuid())
  orderId       String
  type          DeliveryWindowType @default(STANDARD)
  scheduledDate DateTime
  timeSlot      String?
  fee           Decimal            @db.Decimal(10, 2)
  createdAt     DateTime           @default(now())

  @@index([orderId])
}

model ShippingLabel {
  id             String   @id @default(cuid())
  shipmentId     String
  carrier        String
  trackingNumber String
  labelUrl       String
  createdAt      DateTime @default(now())

  @@index([shipmentId])
}

model RecoveryCode {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code   String
  usedAt DateTime?

  @@index([userId])
}

// === G12: Marketing Enhancement ===

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model PromotionRule {
  id                String   @id @default(cuid())
  name              String
  maxCoupons        Int      @default(1)
  maxDeals          Int      @default(1)
  allowStacking     Boolean  @default(false)
  excludeCategories Json?
